# Hardened systemd unit for running AltWarden as its own unprivileged user.
[Unit]
Description=AltWarden Discord verification bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=altwarden
Group=altwarden
WorkingDirectory=/opt/altwarden
# Read by systemd as root before it drops privileges: keep it root-owned, mode 600.
EnvironmentFile=/etc/altwarden/altwarden.env
StateDirectory=altwarden
StateDirectoryMode=0700
ExecStart=/opt/altwarden/venv/bin/python -m altwarden --public-url https://your.site --port 8892 --data /var/lib/altwarden
Restart=on-failure
RestartSec=15

# --- sandboxing ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
MemoryMax=768M
TasksMax=64

[Install]
WantedBy=multi-user.target
