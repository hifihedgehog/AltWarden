# Hardened systemd unit for running AltWarden as its own unprivileged user.
[Unit]
Description=AltWarden Discord verification bot
Wants=network-online.target
After=network-online.target
# Restart= can start the bot at most 20 times in 300 seconds at RestartSec=15, so this limit stops only a faster
# loop. A bot waiting out a Discord outage must never reach it, because a tripped limit stays failed until someone acts.
StartLimitIntervalSec=300
StartLimitBurst=25

[Service]
Type=simple
User=altwarden
Group=altwarden
WorkingDirectory=/opt/altwarden
# Read by systemd as root before it drops privileges: keep it root-owned, mode 600.
EnvironmentFile=/etc/altwarden/altwarden.env
StateDirectory=altwarden
StateDirectoryMode=0700
ExecStart=/opt/altwarden/venv/bin/python -m altwarden --public-url https://your.site --port 8892 --data /var/lib/altwarden
Restart=on-failure
RestartSec=15
# 78: Discord refused the token or a required intent. A restart can't fix that, and each try spends a login.
RestartPreventExitStatus=78
LimitNOFILE=8192

# --- sandboxing ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# No AF_NETLINK: without it getaddrinfo takes both IPv4 and IPv6 as up, and still sorts unreachable addresses last.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
