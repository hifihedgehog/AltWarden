# Secrets only. Everything else is set in Discord or on the dashboard.
# Keep this file private: chmod 600 .env
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
# 32 random bytes, base64. Create one with: python -m altwarden.keygen
# Losing this key makes every stored identifier unmatchable, so back it up on its own.
MASTER_KEY=
# Optional. Only used if a server turns on the outside VPN lookup. Sends members' IPs to proxycheck.io.
PROXYCHECK_KEY=
